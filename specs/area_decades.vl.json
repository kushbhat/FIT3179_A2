{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Section 1: photos per decade, 1860s to 1950s.",
  "width": 400,
  "height": 240,
  "data": {
    "url": "data/photos_by_decade.csv",
    "format": {
      "type": "csv",
      "parse": {
        "decade": "number",
        "n": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.decade >= 1860 && datum.decade <= 1950"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "n",
          "as": "photos"
        }
      ],
      "groupby": [
        "decade"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "color": "#8c3b2a",
        "opacity": 0.22,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "quantitative",
          "axis": {
            "values": [
              1860,
              1870,
              1880,
              1890,
              1900,
              1910,
              1920,
              1930,
              1940,
              1950
            ],
            "labelExpr": "datum.value + 's'",
            "title": null,
            "labelAngle": 0,
            "grid": false
          },
          "scale": {
            "domain": [
              1855,
              1955
            ]
          }
        },
        "y": {
          "field": "photos",
          "type": "quantitative",
          "title": "Photos with a date and a place",
          "scale": {
            "domain": [
              0,
              6200
            ],
            "nice": false
          },
          "axis": {
            "labelExpr": "format(datum.value, ',')",
            "values": [
              0,
              1000,
              2000,
              3000,
              4000,
              5000,
              6000
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#8c3b2a",
        "strokeWidth": 2,
        "interpolate": "monotone",
        "point": {
          "filled": true,
          "color": "#8c3b2a",
          "size": 45
        }
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "quantitative"
        },
        "y": {
          "field": "photos",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "decade",
            "title": "Decade starting"
          },
          {
            "field": "photos",
            "title": "Photos",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "decade": 1920,
            "photos": 5300,
            "label": "Peak: about 5,300 photos in the 1920s"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -14,
        "fontSize": 12,
        "color": "#2b2118",
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "quantitative"
        },
        "y": {
          "field": "photos",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "decade": 1950,
            "photos": 1370,
            "label": "Sharp fall after the 1950s"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "dy": 26,
        "fontSize": 11,
        "color": "#6f6254",
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "quantitative"
        },
        "y": {
          "field": "photos",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#f4ecdc",
    "font": "Source Serif 4, Georgia, serif",
    "axis": {
      "labelColor": "#6f6254",
      "titleColor": "#2b2118",
      "gridColor": "#e2d6bf",
      "domainColor": "#b9a98e",
      "tickColor": "#b9a98e",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFont": "Source Serif 4, Georgia, serif",
      "labelFont": "Source Serif 4, Georgia, serif"
    },
    "legend": {
      "labelColor": "#6f6254",
      "titleColor": "#2b2118",
      "labelFont": "Source Serif 4, Georgia, serif",
      "titleFont": "Source Serif 4, Georgia, serif"
    },
    "title": {
      "color": "#2b2118",
      "font": "Playfair Display, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "subtitleColor": "#6f6254",
      "subtitleFont": "Source Serif 4, Georgia, serif"
    }
  }
}