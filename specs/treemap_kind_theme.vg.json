{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Section 4: the most common caption words, grouped by what they describe (treemap), with an era selector.",
  "width": 780,
  "height": 440,
  "padding": 5,
  "autosize": "pad",
  "background": "#f4ecdc",
  "data": [
    {
      "name": "groups",
      "values": [
        {
          "word": "street",
          "group": "Streets and buildings"
        },
        {
          "word": "building",
          "group": "Streets and buildings"
        },
        {
          "word": "house",
          "group": "Streets and buildings"
        },
        {
          "word": "hotel",
          "group": "Streets and buildings"
        },
        {
          "word": "school",
          "group": "Streets and buildings"
        },
        {
          "word": "church",
          "group": "Streets and buildings"
        },
        {
          "word": "home",
          "group": "Streets and buildings"
        },
        {
          "word": "hall",
          "group": "Streets and buildings"
        },
        {
          "word": "bank",
          "group": "Streets and buildings"
        },
        {
          "word": "office",
          "group": "Streets and buildings"
        },
        {
          "word": "hospital",
          "group": "Streets and buildings"
        },
        {
          "word": "station",
          "group": "Railways and roads"
        },
        {
          "word": "railway",
          "group": "Railways and roads"
        },
        {
          "word": "bridge",
          "group": "Railways and roads"
        },
        {
          "word": "road",
          "group": "Railways and roads"
        },
        {
          "word": "construction",
          "group": "Railways and roads"
        },
        {
          "word": "river",
          "group": "Rivers and water"
        },
        {
          "word": "creek",
          "group": "Rivers and water"
        },
        {
          "word": "flood",
          "group": "Rivers and water"
        },
        {
          "word": "island",
          "group": "Rivers and water"
        },
        {
          "word": "water",
          "group": "Rivers and water"
        },
        {
          "word": "timber",
          "group": "Farming and industry"
        },
        {
          "word": "sugar",
          "group": "Farming and industry"
        },
        {
          "word": "gold",
          "group": "Farming and industry"
        },
        {
          "word": "farm",
          "group": "Farming and industry"
        },
        {
          "word": "family",
          "group": "People and events"
        },
        {
          "word": "children",
          "group": "People and events"
        },
        {
          "word": "people",
          "group": "People and events"
        },
        {
          "word": "women",
          "group": "People and events"
        },
        {
          "word": "queen",
          "group": "People and events"
        },
        {
          "word": "army",
          "group": "People and events"
        },
        {
          "word": "royal",
          "group": "People and events"
        },
        {
          "word": "march",
          "group": "People and events"
        },
        {
          "word": "world",
          "group": "People and events"
        },
        {
          "word": "american",
          "group": "People and events"
        },
        {
          "word": "town",
          "group": "Towns and places"
        },
        {
          "word": "district",
          "group": "Towns and places"
        },
        {
          "word": "mount",
          "group": "Towns and places"
        },
        {
          "word": "city",
          "group": "Towns and places"
        },
        {
          "word": "park",
          "group": "Towns and places"
        },
        {
          "word": "bundaberg",
          "group": "Towns and places"
        },
        {
          "word": "gympie",
          "group": "Towns and places"
        },
        {
          "word": "warwick",
          "group": "Towns and places"
        },
        {
          "word": "cairns",
          "group": "Towns and places"
        },
        {
          "word": "mackay",
          "group": "Towns and places"
        },
        {
          "word": "stanthorpe",
          "group": "Towns and places"
        }
      ]
    },
    {
      "name": "raw",
      "url": "data/words_by_era.csv",
      "format": {
        "type": "csv",
        "parse": {
          "n": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "expr": "(eraSel == 'All eras' || datum.era == eraSel) ? datum.n : 0",
          "as": "v"
        },
        {
          "type": "aggregate",
          "groupby": [
            "word"
          ],
          "fields": [
            "v"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "size"
          ],
          "drop": false
        },
        {
          "type": "lookup",
          "from": "groups",
          "key": "word",
          "fields": [
            "word"
          ],
          "values": [
            "group"
          ],
          "as": [
            "group"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.group != null"
        },
        {
          "type": "formula",
          "expr": "datum.group + '|' + datum.word",
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "datum.group",
          "as": "parent"
        }
      ]
    },
    {
      "name": "mid",
      "source": "raw",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "group"
          ],
          "fields": [
            "size"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ],
          "drop": false
        },
        {
          "type": "formula",
          "expr": "datum.group",
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "'root'",
          "as": "parent"
        }
      ]
    },
    {
      "name": "rootnode",
      "values": [
        {
          "id": "root",
          "parent": null
        }
      ]
    },
    {
      "name": "tree",
      "source": [
        "rootnode",
        "mid",
        "raw"
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "size",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "ratio": 1.4,
          "size": [
            780,
            440
          ],
          "paddingInner": 2,
          "paddingOuter": 3,
          "paddingTop": 22,
          "round": true
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "g",
      "type": "ordinal",
      "domain": [
        "Streets and buildings",
        "Railways and roads",
        "Rivers and water",
        "Farming and industry",
        "People and events",
        "Towns and places"
      ],
      "range": [
        "#8c5a3c",
        "#3b5b7a",
        "#4f6d5a",
        "#8f6f0a",
        "#a4463b",
        "#6b4f7a"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          }
        },
        "update": {
          "fill": {
            "signal": "datum.depth == 2 ? (datum.size > 0 ? scale('g', datum.group) : 'transparent') : (datum.depth == 1 ? (datum.total > 0 ? '#e2d3b8' : 'transparent') : 'transparent')"
          },
          "tooltip": {
            "signal": "datum.depth == 2 ? {'Word': datum.word, 'Group': datum.group, 'Appearances in captions': format(datum.size, ',')} : (datum.depth == 1 ? {'Group': datum.group, 'Appearances': format(datum.total, ',')} : null)"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "baseline": {
            "value": "top"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#2b2118"
          },
          "font": {
            "value": "Source Serif 4, Georgia, serif"
          }
        },
        "update": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 4"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 10"
          },
          "text": {
            "signal": "datum.depth == 1 && datum.total > 0 && (datum.x1 - datum.x0) > 24 ? datum.group : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "baseline": {
            "value": "top"
          },
          "fill": {
            "value": "#fbf6ea"
          },
          "font": {
            "value": "Source Serif 4, Georgia, serif"
          },
          "fontWeight": {
            "value": "bold"
          }
        },
        "update": {
          "x": {
            "signal": "datum.x0 + 5"
          },
          "y": {
            "signal": "datum.y0 + 4"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 8"
          },
          "fontSize": {
            "signal": "(datum.x1 - datum.x0) > 110 && (datum.y1 - datum.y0) > 60 ? 15 : 11"
          },
          "text": {
            "signal": "datum.depth == 2 && datum.size > 0 && (datum.y1 - datum.y0) > 16 && (datum.x1 - datum.x0) > 36 ? datum.word : ''"
          }
        }
      }
    }
  ],
  "signals": [
    {
      "name": "eraSel",
      "value": "All eras",
      "bind": {
        "input": "radio",
        "name": "Show words from: ",
        "options": [
          "All eras",
          "Before 1900",
          "1900-1919",
          "1920-1939",
          "1940 onwards"
        ]
      }
    }
  ]
}