{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Section 2, chart 1: proportional symbol map of photographed places, one small map per era.",
  "data": {
    "url": "data/places_by_era.csv",
    "format": {
      "type": "csv",
      "parse": {
        "lat": "number",
        "lon": "number",
        "n": "number"
      }
    }
  },
  "columns": 2,
  "spacing": 8,
  "concat": [
    {
      "title": {
        "text": "Before 1900",
        "anchor": "start",
        "fontSize": 14,
        "font": "Playfair Display, Georgia, serif",
        "color": "#2b2118"
      },
      "width": 270,
      "height": 340,
      "projection": {
        "type": "conicEqualArea",
        "rotate": [
          -146,
          0
        ],
        "parallels": [
          -12,
          -26
        ]
      },
      "layer": [
        {
          "data": {
            "url": "data/qld_lga.geojson",
            "format": {
              "type": "json",
              "property": "features"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#e8dcc4",
            "stroke": "#d3c3a0",
            "strokeWidth": 0.35
          }
        },
        {
          "transform": [
            {
              "filter": "datum.era === 'Before 1900'"
            },
            {
              "aggregate": [
                {
                  "op": "sum",
                  "field": "n",
                  "as": "photos"
                }
              ],
              "groupby": [
                "place",
                "lat",
                "lon"
              ]
            }
          ],
          "mark": {
            "type": "circle",
            "fill": "#8c3b2a",
            "fillOpacity": 0.5,
            "stroke": "#f4ecdc",
            "strokeWidth": 0.4
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "photos",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  2000
                ],
                "range": [
                  3,
                  1600
                ]
              },
              "legend": {
                "title": "Photos per place",
                "values": [
                  100,
                  500,
                  1000,
                  2000
                ],
                "orient": "right"
              }
            },
            "tooltip": [
              {
                "field": "place",
                "title": "Place"
              },
              {
                "field": "photos",
                "title": "Photos",
                "format": ","
              }
            ]
          }
        }
      ]
    },
    {
      "title": {
